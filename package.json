{
  "name": "moonanbot",
  "version": "0.0.1-rc.3",
  "private": true,
  "description": "A multi-platform AI chat bot exploring lifelike presence.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pheobe-Southwood/MoonanBot.git"
  },
  "homepage": "https://github.com/Pheobe-Southwood/MoonanBot#readme",
  "bugs": "https://github.com/Pheobe-Southwood/MoonanBot/issues",
  "keywords": ["ai", "chatbot", "onebot", "roleplay", "agent"],
  "type": "module",
  "bin": {
    "moonanbot": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "pnpm --dir apps/web dev",
    "build:server": "tsup",
    "build:web": "pnpm --dir apps/web build",
    "build": "pnpm build:server && pnpm build:web",
    "typecheck": "tsc --noEmit && pnpm --dir apps/web typecheck",
    "lint": "eslint src test apps/web/src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "eval:live": "tsx scripts/live-evaluation.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@fastify/cookie": "11.0.2",
    "@fastify/static": "8.3.0",
    "@fastify/websocket": "11.2.0",
    "fastify": "5.6.0",
    "typebox": "1.3.10",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.35.0",
    "tsx": "4.20.5",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
